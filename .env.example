# Public URL of the deployed site (used for canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead email notifications (required for forms to work) -----------------
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives every form submission (comma-separate for several)
LEAD_NOTIFY_EMAIL=
# Sender. Use onboarding@resend.dev while testing; use an address on your
# verified domain in production, e.g. "NIVARO Website <leads@yourdomain.com>"
RESEND_FROM_EMAIL=NIVARO Website <onboarding@resend.dev>

# Optional backup copy of leads: "local" (dev only, default) | "supabase" | "sheets"
WAITLIST_STORAGE=local
